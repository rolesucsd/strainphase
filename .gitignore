# Python / packaging
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
strainphase.egg-info/
PKG-INFO

# Virtual environments
venv/
.venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg

# OS / editor
.DS_Store
.idea/
.vscode/

# Private working directories, not distributed.
# NOTE: the public benchmark suite lives in benchmark/ (no trailing "s") and is
# tracked. Keep these patterns anchored so they cannot swallow it.
/docs/
/validation/
/benchmarks/

# Generated data
data/
tmp/
tmp2/
results/
strains/

# ...but the benchmark suite's tracked data manifest is not generated data.
!benchmark/data/
!benchmark/data/**

# Reference genomes downloaded by benchmark/scripts/fetch_genomes.py
/benchmark/genomes/

# Conda environments
.conda/

# Local instructions
agents.md
future_work.md
submit_bcf_to_vcf_array.sh
run_bcf_to_vcf_array.sh
# Public benchmark suite — untracked until it has been run on real assemblies
# and verified. The work is preserved in this branch's history; it is held out
# of the tree so an untested comparison cannot be mistaken for a finished one.
/benchmark/
