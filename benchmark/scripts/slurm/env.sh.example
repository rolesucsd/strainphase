# Copy to env.sh, edit for your cluster, and pass with:
#     scripts/slurm/submit.sh --env-setup scripts/slurm/env.sh ...
#
# Every job sources this before doing anything. It exists because activating a
# conda environment inside a batch job is site-specific and getting it wrong is
# the single most common reason a cluster benchmark run produces nothing.

# --- Option A: conda ---------------------------------------------------------
# module load anaconda3
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate spbench

# --- Option B: a plain virtualenv --------------------------------------------
# source /path/to/venv/bin/activate

# --- Comparator tools --------------------------------------------------------
# Each comparator lives in its own conda environment (see benchmark/envs/), so
# put their bin directories on PATH here. Tools not on PATH are reported as
# `skipped` rows rather than failing the run.
#
# CONDA_ENVS="$(conda info --base)/envs"
# export PATH="$CONDA_ENVS/floria/bin:$CONDA_ENVS/strainy/bin:$CONDA_ENVS/devider/bin:$PATH"

# --- Scratch -----------------------------------------------------------------
# Datasets and per-tool working directories are large. Keep temporary files off
# $HOME so a quota does not kill a job eight hours in.
# export TMPDIR=/scratch/$USER/tmp
# mkdir -p "$TMPDIR"

# Thread pinning: BLAS oversubscription inside an already-parallel array task
# slows everything down. One BLAS thread per process is the right default here.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
