"""strainphase benchmark: real strain assemblies -> tool comparison.

    snakemake --profile <your-slurm-profile> --use-conda

Each dataset is one strain group at one seed. One assembly is drawn as the
reference; the rest are the strains in the mixture. Their true haplotypes come
from `minimap2 -cx asm5` of each assembly against that reference, so the
mutations are real. Abundance over time is simulated from named biological
archetypes. Reads come from Badread. Alignment and variant calling run the
production commands (workflow/rules/pipeline.smk).

The DAG is:

    truth ──> simulate_reads ──> align ──> call ──> union
                                   │                  │
                                   └──────┬───────────┘
                                          v
                            strainphase / floria / strainy
                                          v
                                        score
                                          v
                                        report
"""

import itertools
from pathlib import Path

configfile: "config/config.yaml"


wildcard_constraints:
    group="[A-Za-z0-9._-]+",
    seed=r"\d+",
    dataset="[A-Za-z0-9._-]+",
    sample="[A-Za-z0-9._-]+",
    tool="[A-Za-z0-9._-]+",


GROUPS = config["groups"]
SEEDS = config["seeds"]
TOOLS = config["tools"]
SIM = config["simulation"]
SAMPLES = [f"T{i + 1}" for i in range(SIM["n_timepoints"])]

#: A dataset is (group, seed). Encoding both in one wildcard keeps every
#: downstream rule single-wildcard, which is what makes the per-(dataset, tool)
#: fan-out readable.
DATASETS = {f"{g}.seed{s}": (g, s) for g, s in itertools.product(GROUPS, SEEDS)}

#: Which tools see all timepoints at once. Single-sample tools are invoked per
#: timepoint and their partitions merged; the multi-sample one is invoked once.
MULTI_SAMPLE = {"strainphase-longitudinal"}

RESULTS = Path("results")


def dataset_dir(dataset):
    return RESULTS / "datasets" / dataset


def group_of(dataset):
    return DATASETS[dataset][0]


def seed_of(dataset):
    return DATASETS[dataset][1]


include: "rules/simulate.smk"
include: "rules/pipeline.smk"
include: "rules/tools.smk"
include: "rules/evaluate.smk"


rule all:
    input:
        RESULTS / "report" / "report.md",
